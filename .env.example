# Optional live Google Routes API. Leave both unset for the local proof of concept.
# Mock reconstruction does not read these values.
ROUTE_OVERLAY_GOOGLE_API_ENABLED=false

# Server-side only. Do not prefix this with NEXT_PUBLIC_.
GOOGLE_ROUTES_API_KEY=

# Optional Google Maps JavaScript basemap for live polylines.
# Leave both unset. Enabling them loads a billable Maps JavaScript script in the browser.
# Live route confirmation stays blocked until this display reports that the map is ready.
ROUTE_OVERLAY_GOOGLE_MAPS_JS_ENABLED=false
GOOGLE_MAPS_JS_API_KEY=

# Local experiment caps are enforced in the server, not by these variables.
# This phase allows 20 computeRoutes calls and 30 intentional map loads.
# ROUTE_OVERLAY_BUDGET_PATH can point at a gitignored counter file.
# ROUTE_OVERLAY_LIVE_EXPERIMENT=true is required before the explicit live test.

# Optional Places API (New) enrichment. Server-side only. Leave both unset.
# Opening-hours fields select the Text Search Enterprise SKU.
# The Phase 5 ceiling is 25 Places requests, 5 additional Routes requests, and 5 map loads.
ROUTE_OVERLAY_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=
